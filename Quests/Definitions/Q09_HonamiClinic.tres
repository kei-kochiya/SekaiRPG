[resource]
script = ExtResource("1_quest")
quest_id = "quest_09_honami_clinic"
quest_name = "Căn cứ bị đột kích & Phòng khám Honami"
description = "Căn cứ Safehouse bị Honami đột nhập thăm dò. Sau khi đối thoại hòa giải, nhóm mở khóa phòng khám tư nhân của Honami (Hub thứ 2), mở khóa tập luyện cùng Honami và kết nối kế hoạch vạch trần âm mưu Thủ Tướng."
