[resource]
script = ExtResource("1_quest")
quest_id = "quest_11_next_pm"
quest_name = "Ghế Thủ Tướng Mới"
description = "Thủ Tướng đã chết. Cả Nightcord ăn mừng và bàn xem ai sẽ là Thủ Tướng kế tiếp: Bộ trưởng Quốc phòng, cấp trên của Mafuyu. Trong lúc trò chuyện, Mizuki lỡ lời khiến Ena nổi giận bỏ đi."
