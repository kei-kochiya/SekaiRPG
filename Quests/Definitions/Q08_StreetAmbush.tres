[resource]
script = ExtResource("1_quest")
quest_id = "quest_08_street_ambush"
quest_name = "Phục kích Ngã tư & Cuộc chiến Sinh tồn"
description = "Nhóm nhận lệnh tuần tra Ngã tư đường phố, bị quân khủng bố phục kích bao vây. Trải qua trận giao tranh ban đầu và màn sinh tồn cứu viện cảm xúc của Mafuyu."
