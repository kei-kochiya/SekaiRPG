[ext_resource type="Script" path="res://Quests/QuestDefinition.gd" id="1_quest"]

[resource]
script = ExtResource("1_quest")
quest_id = "quest_14_mole"
quest_name = "Kẻ Nằm Vùng"
description = "Mafuyu phát hiện Kanade là đặc vụ cảnh sát cài vào Nightcord và ra lệnh cho Mizuki và Ichika hạ cô. Ichika chết lặng, Mizuki bị giết; khi Kanade sắp ra tay với Ichika, thời gian như chậm lại và Ảnh Sát kết liễu Kanade."
